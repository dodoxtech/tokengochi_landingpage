---
import appIcon from "../assets/icons/app-icon-32.png?url";

const links = [
  { href: "#how-it-works", label: "How it works" },
  { href: "#features", label: "Features" },
  { href: "#download", label: "Download" },
  { href: "https://github.com", label: "GitHub" },
];
---

<header class="relative z-10 border-b-[3px] border-ink/40">
  <nav
    class="mx-auto flex max-w-[1100px] items-center justify-between gap-4 px-6 py-4"
    aria-label="Primary"
  >
    <a href="#top" class="flex items-center gap-3 focus-visible:outline-none">
      <img
        src={appIcon}
        alt="Tokengochi"
        width="32"
        height="32"
        class="pixelated"
      />
      <span class="font-heading text-lg text-text">Tokengochi</span>
    </a>

    <ul class="hidden items-center gap-6 font-body text-sm text-text-dim sm:flex">
      {
        links.map((link) => (
          <li>
            <a
              href={link.href}
              class="transition-colors hover:text-text focus-visible:outline-none"
            >
              {link.label}
            </a>
          </li>
        ))
      }
    </ul>
  </nav>
</header>
