---
import PixelCard from "./PixelCard.astro";
import hatchlingSheet from "../assets/sprites/hatchling/hatchling.png?url";
import hatLeaf from "../assets/sprites/items/hat-leaf-sprite-32x32.png?url";
import hatMushroom from "../assets/sprites/items/hat-mushroom-sprite-32x32.png?url";
import scarfSunset from "../assets/sprites/items/scarf-sunset-sprite-32x32.png?url";

const compactFeatures = [
  {
    title: "Local-first",
    stat: "0 calls",
    copy: "The core loop tails local Claude Code logs and keeps state on your machine.",
    icon: "local",
  },
  {
    title: "Cross-platform",
    stat: "3 OS",
    copy: "Built for macOS, Windows, and Ubuntu, with X11 first and Wayland best-effort.",
    icon: "platform",
  },
  {
    title: "Near-zero footprint",
    stat: "<100 MB",
    copy: "Designed for negligible idle CPU, so the pet can stay ambient all day.",
    icon: "footprint",
  },
  {
    title: "Extensible",
    stat: "Plugins",
    copy: "Claude Code is first, with provider plugins planned for other LLM CLIs and tools.",
    icon: "plugin",
  },
];
---

<section id="features" class="relative bg-night px-6 py-16 sm:py-20 lg:py-24">
  <div class="mx-auto max-w-[1100px]">
    <div class="max-w-2xl">
      <h2 class="font-heading text-3xl leading-tight text-text sm:text-4xl">
        Lovable on top, careful underneath
      </h2>
      <p class="mt-4 font-body text-base leading-7 text-text-dim sm:text-lg">
        Tokengochi is a tiny pet with serious boundaries: local by default,
        earned progression, and a core loop that stays out of your way.
      </p>
    </div>

    <div
      class="feature-grid mt-10"
      aria-label="Tokengochi features and trust points"
    >
      <PixelCard class="feature-card feature-card--big feature-card--walk">
        <article class="feature-article" data-reveal>
          <div class="feature-copy">
            <h3>It actually lives on your screen</h3>
            <p>
              It wanders screen edges and your taskbar, chases food, idles, and
              sleeps when you do.
            </p>
          </div>

          <div class="walk-panel" aria-hidden="true">
            <div class="screen-edge"></div>
            <div
              class="walk-pet pixelated"
              style={`background-image: url(${hatchlingSheet})`}
            ></div>
          </div>
        </article>
      </PixelCard>

      <PixelCard class="feature-card feature-card--big feature-card--progression">
        <article class="feature-article" data-reveal style="--reveal-delay: 80ms">
          <div class="feature-copy">
            <h3>Progression that respects your time</h3>
            <p>
              Streaks, evolution stages, cosmetics, and collection albums are
              earned in-app. No real-money purchases.
            </p>
          </div>

          <div class="progression-panel" aria-hidden="true">
            <div class="album-card album-card--stage">
              <span>Stage</span>
              <div
                class="album-pet pixelated"
                style={`background-image: url(${hatchlingSheet})`}
              ></div>
            </div>
            <div class="album-card album-card--items">
              <span>Unlocks</span>
              <div class="item-row">
                <img class="pixelated shop-item" src={hatLeaf} alt="" width="32" height="32" />
                <img class="pixelated shop-item" src={scarfSunset} alt="" width="32" height="32" />
                <img class="pixelated shop-item" src={hatMushroom} alt="" width="32" height="32" />
              </div>
            </div>
            <div class="streak-strip">
              <span></span><span></span><span></span><span></span><span></span>
            </div>
          </div>
        </article>
      </PixelCard>

      {
        compactFeatures.map((feature, index) => (
          <PixelCard class={`feature-card feature-card--compact feature-card--${feature.icon}`}>
            <article
              class="feature-article compact-article"
              data-reveal
              style={`--reveal-delay: ${160 + index * 60}ms`}
            >
              <div class="compact-top">
                <span class="stat-chip">{feature.stat}</span>
                <span class:list={["pixel-icon", `pixel-icon--${feature.icon}`]} aria-hidden="true">
                  {feature.icon === "platform" && (
                    <>
                      <span></span><span></span><span></span>
                    </>
                  )}
                </span>
              </div>
              <h3>{feature.title}</h3>
              <p>{feature.copy}</p>
            </article>
          </PixelCard>
        ))
      }
    </div>
  </div>
</section>

<script>
  import { initReveals } from "../scripts/reveal";

  initReveals();
</script>

<style>
  [data-reveal].reveal-pending {
    opacity: 0;
    transform: translateY(8px);
  }

  [data-reveal].is-revealed {
    opacity: 1;
    transform: translateY(0);
  }

  @media (prefers-reduced-motion: no-preference) {
    [data-reveal].reveal-pending,
    [data-reveal].is-revealed {
      transition:
        opacity 420ms ease-out var(--reveal-delay, 0ms),
        transform 420ms ease-out var(--reveal-delay, 0ms);
      will-change: opacity, transform;
    }

    [data-reveal].is-revealed {
      will-change: auto;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    [data-reveal] {
      opacity: 1;
      transform: none;
    }
  }

  .feature-grid {
    display: grid;
    grid-template-columns: 1fr;
    gap: 20px;
  }

  .feature-card {
    min-width: 0;
    background:
      linear-gradient(180deg, rgba(110, 231, 160, 0.055), rgba(110, 231, 160, 0)),
      var(--color-night-soft);
  }

  .feature-card--progression {
    background:
      linear-gradient(180deg, rgba(255, 212, 102, 0.1), rgba(255, 212, 102, 0)),
      var(--color-night-soft);
  }

  .feature-article {
    display: flex;
    min-height: 100%;
    flex-direction: column;
  }

  .feature-copy h3,
  .compact-article h3 {
    color: var(--color-text);
    font-family: var(--font-heading);
    font-size: 1.5rem;
    line-height: 1.05;
  }

  .feature-copy p,
  .compact-article p {
    margin-top: 0.75rem;
    color: var(--color-text-dim);
    font-family: var(--font-body);
    font-size: 0.95rem;
    line-height: 1.55;
  }

  .walk-panel,
  .progression-panel {
    position: relative;
    min-height: 184px;
    margin-top: 1.5rem;
    overflow: hidden;
    border: 3px solid var(--color-ink);
    border-radius: 6px;
    background:
      linear-gradient(135deg, rgba(255, 212, 102, 0.28), transparent 54%),
      var(--color-cream);
    box-shadow: inset 0 -4px 0 rgba(29, 24, 48, 0.12);
  }

  .screen-edge {
    position: absolute;
    left: 18px;
    right: 18px;
    bottom: 28px;
    height: 12px;
    border: 3px solid var(--color-ink);
    border-radius: 3px;
    background:
      repeating-linear-gradient(
        90deg,
        rgba(29, 24, 48, 0.14) 0 16px,
        rgba(29, 24, 48, 0.02) 16px 28px
      ),
      var(--color-night-soft);
  }

  .screen-edge::before {
    position: absolute;
    right: 16px;
    bottom: 13px;
    width: 54px;
    height: 34px;
    border: 3px solid var(--color-ink);
    border-bottom: 0;
    border-radius: 4px 4px 0 0;
    background: var(--color-night);
    content: "";
  }

  .walk-pet {
    position: absolute;
    left: 0;
    bottom: 18px;
    width: 184px;
    height: 184px;
    background-repeat: no-repeat;
    background-position: -736px 0;
    transform: translateX(-44px) scale(0.74);
    transform-origin: bottom left;
  }

  .progression-panel {
    display: grid;
    grid-template-columns: minmax(0, 1fr);
    gap: 12px;
    padding: 14px;
  }

  .album-card {
    position: relative;
    min-height: 92px;
    overflow: hidden;
    border: 3px solid var(--color-ink);
    border-radius: 5px;
    background: rgba(251, 240, 215, 0.7);
  }

  .album-card span {
    position: absolute;
    left: 10px;
    top: 8px;
    color: var(--color-ink);
    font-family: var(--font-heading);
    font-size: 0.875rem;
    line-height: 1;
  }

  .album-pet {
    position: absolute;
    right: -18px;
    bottom: -42px;
    width: 184px;
    height: 184px;
    background-repeat: no-repeat;
    background-position: -736px -368px;
    transform: scale(0.58);
    transform-origin: bottom right;
  }

  .item-row {
    position: absolute;
    inset: auto 8px 10px 8px;
    display: flex;
    justify-content: flex-end;
    gap: 8px;
  }

  .shop-item {
    width: 46px;
    height: 46px;
    filter: drop-shadow(3px 4px 0 rgba(29, 24, 48, 0.2));
  }

  .streak-strip {
    display: grid;
    grid-template-columns: repeat(5, minmax(0, 1fr));
    gap: 8px;
  }

  .streak-strip span {
    height: 12px;
    border: 2px solid var(--color-ink);
    border-radius: 2px;
    background: var(--color-token-green);
  }

  .compact-article {
    justify-content: space-between;
    gap: 18px;
  }

  .compact-top {
    display: flex;
    align-items: flex-start;
    justify-content: space-between;
    gap: 14px;
  }

  .stat-chip {
    display: inline-flex;
    min-height: 32px;
    align-items: center;
    border: 3px solid var(--color-token-green);
    border-radius: 4px;
    background: var(--color-ink);
    padding: 0 10px;
    color: var(--color-token-green);
    font-family: var(--font-heading);
    font-size: 0.95rem;
    line-height: 1;
    white-space: nowrap;
  }

  .pixel-icon {
    position: relative;
    display: block;
    flex: 0 0 auto;
    width: 44px;
    height: 44px;
    border: 3px solid var(--color-ink);
    border-radius: 4px;
    background: var(--color-cream);
    box-shadow: 3px 3px 0 rgba(29, 24, 48, 0.28);
  }

  .pixel-icon--local::before {
    position: absolute;
    inset: 9px 10px 12px;
    border: 3px solid var(--color-ink);
    border-radius: 3px 3px 1px 1px;
    background: var(--color-night-soft);
    content: "";
  }

  .pixel-icon--local::after {
    position: absolute;
    left: 13px;
    right: 13px;
    bottom: 8px;
    height: 3px;
    background: var(--color-token-green);
    box-shadow: 0 -8px 0 var(--color-token-green);
    content: "";
  }

  .pixel-icon--platform {
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 3px;
  }

  .pixel-icon--platform span {
    width: 8px;
    height: 18px;
    border: 2px solid var(--color-ink);
    border-radius: 2px;
    background: var(--color-token-green);
  }

  .pixel-icon--platform span:nth-child(2) {
    height: 24px;
    background: var(--color-moon-yellow);
  }

  .pixel-icon--platform span:nth-child(3) {
    background: var(--color-pet-orange);
  }

  .pixel-icon--footprint::before,
  .pixel-icon--footprint::after {
    position: absolute;
    border: 3px solid var(--color-ink);
    border-radius: 3px;
    background: var(--color-token-green);
    content: "";
  }

  .pixel-icon--footprint::before {
    left: 10px;
    top: 10px;
    width: 12px;
    height: 18px;
  }

  .pixel-icon--footprint::after {
    right: 9px;
    bottom: 8px;
    width: 15px;
    height: 22px;
  }

  .pixel-icon--plugin::before {
    position: absolute;
    inset: 10px;
    border: 3px solid var(--color-ink);
    border-radius: 3px;
    background: var(--color-moon-yellow);
    content: "";
  }

  .pixel-icon--plugin::after {
    position: absolute;
    left: 17px;
    top: 5px;
    width: 10px;
    height: 34px;
    background:
      linear-gradient(var(--color-ink), var(--color-ink)) center 0 / 10px 3px no-repeat,
      linear-gradient(var(--color-ink), var(--color-ink)) center 31px / 10px 3px no-repeat,
      transparent;
    content: "";
  }

  @media (min-width: 640px) {
    .progression-panel {
      grid-template-columns: 1fr 1fr;
    }

    .streak-strip {
      grid-column: 1 / -1;
    }
  }

  @media (min-width: 1024px) {
    .feature-grid {
      grid-template-columns: repeat(6, minmax(0, 1fr));
      grid-auto-rows: minmax(170px, auto);
      gap: 22px;
    }

    .feature-card--big {
      grid-column: span 3;
      grid-row: span 2;
    }

    .feature-card--compact {
      grid-column: span 3;
    }

    .feature-copy h3 {
      font-size: 1.75rem;
    }

    .walk-panel,
    .progression-panel {
      min-height: 214px;
    }

    .progression-panel {
      align-content: end;
    }
  }

  @media (prefers-reduced-motion: no-preference) {
    .walk-pet {
      animation:
        walk-cycle 720ms steps(1) infinite,
        walk-path 7s linear infinite;
      will-change: transform, background-position;
    }

    .shop-item {
      animation: item-bob 3.6s ease-in-out infinite;
    }

    .shop-item:nth-child(2) {
      animation-delay: 0.35s;
    }

    .shop-item:nth-child(3) {
      animation-delay: 0.7s;
    }
  }

  @keyframes walk-cycle {
    0% {
      background-position: -736px 0;
    }
    16.67% {
      background-position: -920px 0;
    }
    33.33% {
      background-position: -1104px 0;
    }
    50% {
      background-position: -1288px 0;
    }
    66.67% {
      background-position: 0 -184px;
    }
    83.33%,
    100% {
      background-position: -184px -184px;
    }
  }

  @keyframes walk-path {
    0% {
      transform: translateX(-62px) scale(0.74);
    }
    100% {
      transform: translateX(calc(100% + 62px)) scale(0.74);
    }
  }

  @keyframes item-bob {
    0%,
    100% {
      transform: translateY(0);
    }
    50% {
      transform: translateY(-5px);
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .walk-pet,
    .shop-item {
      animation: none;
    }

    .walk-pet {
      background-position: -736px 0;
      transform: translateX(28px) scale(0.74);
    }
  }
</style>
