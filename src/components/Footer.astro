---
import hatchlingSheet from "../assets/sprites/hatchling/hatchling.png?url";
import effectsSheet from "../assets/sprites/effects/effects.png?url";

const year = new Date().getFullYear();
const columns = [
  {
    title: "Product",
    links: [
      { href: "https://github.com/dodoxtech/tokengochi", label: "GitHub" },
      { href: "https://github.com/dodoxtech/tokengochi/releases/latest", label: "Releases" },
      { href: "https://github.com/dodoxtech/tokengochi/blob/main/CHANGELOG.md", label: "Changelog" },
    ],
  },
  {
    title: "Community",
    links: [
      { href: "https://github.com/dodoxtech/tokengochi/issues", label: "Issues" },
      { href: "https://ko-fi.com/dodoxtech", label: "Ko-fi" },
    ],
  },
  {
    title: "Legal",
    links: [
      { href: "https://github.com/dodoxtech/tokengochi/blob/main/LICENSE", label: "MIT license" },
    ],
  },
];
---

<footer id="footer" class="site-footer" aria-label="Footer">
  <div class="footer-shelf" aria-hidden="true">
    <span></span>
    <span></span>
    <span></span>
  </div>

  <div class="footer-inner">
    <div class="footer-brand">
      <div class="sleeping-scene" aria-hidden="true">
        <div
          class="sleep-zzz pixelated"
          style={`background-image: url(${effectsSheet})`}
        ></div>
        <div
          class="sleep-pet pixelated"
          style={`background-image: url(${hatchlingSheet})`}
        ></div>
      </div>

      <h2>Tokengochi</h2>
      <p>
        A tiny local-first desktop pet for Claude Code users who want their
        token burn to feel a little less abstract.
      </p>
    </div>

    <nav class="footer-links" aria-label="Footer links">
      {
        columns.map((column) => (
          <section>
            <h3>{column.title}</h3>
            <ul>
              {column.links.map((link) => (
                <li>
                  <a href={link.href}>{link.label}</a>
                </li>
              ))}
            </ul>
          </section>
        ))
      }
    </nav>

    <div class="footer-bottom">
      <p>Made by dodoxtech. Not affiliated with Anthropic.</p>
      <p>&copy; {year} Tokengochi.</p>
    </div>
  </div>
</footer>

<style>
  .site-footer {
    position: relative;
    overflow: hidden;
    border-top: 3px solid rgba(29, 24, 48, 0.9);
    background:
      linear-gradient(180deg, rgba(36, 30, 66, 0.92), rgba(20, 16, 38, 0.96)),
      var(--color-night-soft);
  }

  .footer-shelf {
    position: relative;
    height: 30px;
    border-bottom: 3px solid var(--color-ink);
    background:
      linear-gradient(90deg, rgba(251, 240, 215, 0.12), transparent 34%),
      var(--color-pet-deep);
    box-shadow: inset 0 6px 0 rgba(255, 212, 102, 0.16);
  }

  .footer-shelf span {
    position: absolute;
    bottom: -3px;
    width: 58px;
    height: 18px;
    border: 3px solid var(--color-ink);
    border-bottom: 0;
    border-radius: 4px 4px 0 0;
    background: var(--color-night-soft);
  }

  .footer-shelf span:nth-child(1) {
    left: max(18px, calc((100vw - 1100px) / 2 + 18px));
  }

  .footer-shelf span:nth-child(2) {
    left: 48%;
    width: 86px;
  }

  .footer-shelf span:nth-child(3) {
    right: max(18px, calc((100vw - 1100px) / 2 + 18px));
  }

  .footer-inner {
    display: grid;
    grid-template-columns: 1fr;
    gap: 32px;
    max-width: 1100px;
    margin: 0 auto;
    padding: 44px 24px 32px;
  }

  .footer-brand {
    max-width: 420px;
  }

  .sleeping-scene {
    position: relative;
    width: 168px;
    height: 110px;
    margin-bottom: 18px;
  }

  .sleep-pet {
    position: absolute;
    left: -30px;
    bottom: -42px;
    width: 184px;
    height: 184px;
    background-repeat: no-repeat;
    background-position: -736px -552px;
    transform: scale(0.56);
    transform-origin: bottom left;
  }

  .sleep-zzz {
    position: absolute;
    left: 84px;
    top: -28px;
    width: 224px;
    height: 308px;
    background-repeat: no-repeat;
    background-position: 0 0;
    transform: scale(0.28);
    transform-origin: top left;
    opacity: 0.92;
  }

  .footer-brand h2 {
    color: var(--color-text);
    font-family: var(--font-heading);
    font-size: clamp(2rem, 7vw, 3.5rem);
    line-height: 0.95;
  }

  .footer-brand p,
  .footer-bottom p {
    color: var(--color-text-dim);
    font-family: var(--font-body);
    font-size: 0.95rem;
    line-height: 1.55;
  }

  .footer-brand p {
    margin-top: 14px;
  }

  .footer-links {
    display: grid;
    grid-template-columns: 1fr;
    gap: 24px;
  }

  .footer-links h3 {
    color: var(--color-moon-yellow);
    font-family: var(--font-heading);
    font-size: 1.15rem;
    line-height: 1;
  }

  .footer-links ul {
    display: grid;
    gap: 10px;
    margin-top: 14px;
  }

  .footer-links a {
    color: var(--color-text);
    font-family: var(--font-body);
    font-size: 0.95rem;
    font-weight: 700;
    text-decoration: underline;
    text-decoration-color: rgba(110, 231, 160, 0.8);
    text-decoration-thickness: 3px;
    text-underline-offset: 5px;
    transition: color 120ms ease-out;
  }

  .footer-links a:hover {
    color: var(--color-token-green);
  }

  .footer-bottom {
    display: grid;
    gap: 8px;
    border-top: 3px solid rgba(251, 240, 215, 0.14);
    padding-top: 22px;
  }

  @media (min-width: 640px) {
    .footer-links {
      grid-template-columns: repeat(3, minmax(0, 1fr));
    }

    .footer-bottom {
      grid-template-columns: 1fr auto;
      align-items: center;
    }
  }

  @media (min-width: 900px) {
    .footer-inner {
      grid-template-columns: minmax(280px, 1fr) minmax(440px, 1.2fr);
      gap: 56px;
      padding-top: 56px;
    }

    .footer-bottom {
      grid-column: 1 / -1;
    }
  }
</style>
