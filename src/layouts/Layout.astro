---
import "../styles/global.css";
import dmSansWoff2 from "@fontsource-variable/dm-sans/files/dm-sans-latin-wght-normal.woff2?url";
import pixelifySansWoff2 from "@fontsource/pixelify-sans/files/pixelify-sans-latin-400-normal.woff2?url";
import hatchlingSheet from "../assets/sprites/hatchling/hatchling.png?url";

interface Props {
  title?: string;
  description?: string;
  image?: string;
}

const {
  title = "Tokengochi — a desktop pet fed by your AI tokens",
  description = "A pixel-art desktop pet that lives on your screen and stays happy on the tokens you burn in Claude Code. Local-first, open source, free.",
  image = "/og.png",
} = Astro.props;

const canonicalUrl = new URL(Astro.url.pathname, Astro.site ?? Astro.url);
const imageUrl = new URL(image, canonicalUrl);
const schema = {
  "@context": "https://schema.org",
  "@type": "SoftwareApplication",
  name: "Tokengochi",
  applicationCategory: "DeveloperApplication",
  operatingSystem: ["macOS", "Windows", "Linux"],
  offers: {
    "@type": "Offer",
    price: "0",
    priceCurrency: "USD",
  },
  license: "https://github.com/dodoxtech/tokengochi/blob/main/LICENSE",
  softwareRequirements: "Claude Code",
  url: canonicalUrl.href,
  image: imageUrl.href,
};
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <meta name="theme-color" content="#141026" />
    <link rel="canonical" href={canonicalUrl.href} />

    <link rel="icon" href="/favicon.ico" sizes="any" />
    <link rel="icon" type="image/svg+xml" href="/icon.svg" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />

    <meta property="og:type" content="website" />
    <meta property="og:site_name" content="Tokengochi" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonicalUrl.href} />
    <meta property="og:image" content={imageUrl.href} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content="Tokengochi pixel pet following a trail of AI tokens on a cozy night desk." />

    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={imageUrl.href} />
    <meta name="twitter:image:alt" content="Tokengochi pixel pet following a trail of AI tokens on a cozy night desk." />

    <script type="application/ld+json" set:html={JSON.stringify(schema)} />

    <link
      rel="preload"
      href={dmSansWoff2}
      as="font"
      type="font/woff2"
      crossorigin
    />
    <link
      rel="preload"
      href={pixelifySansWoff2}
      as="font"
      type="font/woff2"
      crossorigin
    />
    <link rel="preload" href={hatchlingSheet} as="image" fetchpriority="high" />
  </head>
  <body class="overflow-x-hidden bg-night text-text">
    <slot />
  </body>
</html>
