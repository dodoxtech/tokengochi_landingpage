---
import "../styles/global.css";
import dmSansWoff2 from "@fontsource-variable/dm-sans/files/dm-sans-latin-wght-normal.woff2?url";
import pixelifySansWoff2 from "@fontsource/pixelify-sans/files/pixelify-sans-latin-400-normal.woff2?url";
import hatchlingSheet from "../assets/sprites/hatchling/hatchling.png?url";

interface Props {
  title?: string;
  description?: string;
}

const {
  title = "Tokengochi",
  description = "Tokengochi — a pixel pet that lives on your desk while you code.",
} = Astro.props;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <meta name="description" content={description} />
    <title>{title}</title>

    <link
      rel="preload"
      href={dmSansWoff2}
      as="font"
      type="font/woff2"
      crossorigin
    />
    <link
      rel="preload"
      href={pixelifySansWoff2}
      as="font"
      type="font/woff2"
      crossorigin
    />
    <link rel="preload" href={hatchlingSheet} as="image" fetchpriority="high" />
  </head>
  <body class="overflow-x-hidden bg-night text-text">
    <slot />
  </body>
</html>
